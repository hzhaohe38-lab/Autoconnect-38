.gitattributes text eol=lf

# Shell scripts and config files are consumed by bash on Linux/WSL.
# Force LF so a Windows checkout with core.autocrlf=true does not break them.
*.sh   text eol=lf
*.conf text eol=lf
*.conf.example text eol=lf

# Go sources and docs
*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary artifacts must never be converted
*.zip  binary
